{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/formal/**",
              "components/interface/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Mono|Instrument Sans|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Mono, Instrument Sans, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|title|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: status, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:nominal|caution|critical|signal|idle)$/]",
        "message": "<Alert> status must be one of 'nominal' | 'caution' | 'critical' | 'signal' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|action|children|family|icon|key|ref|className|style|children)$/]",
        "message": "<Band> doesn't accept that prop. Declared props: eyebrow, title, action, children, family, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='family'] > Literal[value!=/^(?:cortex|ion|neuron|glia|retina|nexo|dendrito|lumen|ritmo|impulso|plexo|iris)$/]",
        "message": "<Band> family must be one of 'cortex' | 'ion' | 'neuron' | 'glia' | 'retina' | 'nexo' | 'dendrito' | 'lumen' | 'ritmo' | 'impulso' | 'plexo' | 'iris'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:calendar|mail|download|chart|users|doc|spark|pulse)$/]",
        "message": "<Band> icon must be one of 'calendar' | 'mail' | 'download' | 'chart' | 'users' | 'doc' | 'spark' | 'pulse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|label2|key|ref|className|style|children)$/]",
        "message": "<BarListItem> doesn't accept that prop. Declared props: label, value, label2."
      },
